{
  "name": "role-lab",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:resitel": "tsc --noEmit && vite build --mode participant",
    "build:web": "tsc --noEmit && tsc -p tsconfig.server.json && vite build --mode web && node scripts/add-csp.mjs && node scripts/check-web-bundle.mjs && node scripts/check-server-functions.mjs",
    "dev:web": "vite --mode web",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "smoke": "node scripts/smoke-check.mjs",
    "calibrate": "node scripts/calibrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
